# Configuración de Entorno MontesSori AI
# Copia este archivo como .env para desarrollo local o configura estas variables en el panel de Render

# Django
SECRET_KEY=montessori-production-secret-key-mit-solve-2027
DEBUG=False
ALLOWED_HOSTS=*

# Base de Datos (Render proporciona DATABASE_URL automáticamente al enlazar PostgreSQL)
# Si se deja vacío en desarrollo local, el sistema utilizará SQLite automáticamente.
# DATABASE_URL=postgresql://montessori_user:password@dpg-xxxx.render.com/montessori_db

# Google Gemini API
# Clave del servidor (NUNCA se envía al cliente frontend).
# Si se omite, el sistema activa automáticamente el Motor Pedagógico de Demostración MontesSori.
GEMINI_API_KEY=

# CORS
CORS_ALLOW_ALL_ORIGINS=True
